rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Clinics, Services & Doctors (Publicly viewable by patients)
    match /clinics/{clinicId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    // Clinic photos stored as Base64 (kept apart from /clinics so list queries stay small).
    match /clinic_images/{clinicId} {
      allow read: if true;
      allow write: if isAuthenticated()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 2. User Profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 3. Appointments (Patients can create & view their own bookings)
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 4. Queues & Tickets (Real-time live queue tracking)
    match /queues/{queueId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /tickets/{ticketId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 5. Clinic reviews (public; patients post their own, others can only mark helpful)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.clinicId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount']);
      allow delete: if false;
    }

    // 6. Rate limit tracking for emails (Cloud Functions access only)
    match /email_send_log/{uid} {
      allow read, write: if false; 
    }
  }
}