rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Clinic profile photos: public read (patient app), signed-in clinic admins upload images up to 5 MB.
    match /clinic_images/{clinicId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
